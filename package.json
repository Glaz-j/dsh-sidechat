{
  "name": "dsh-parallel-chat",
  "version": "0.1.0-beta.1",
  "description": "Run isolated, read-only parallel conversations alongside an active DeepSeek Harness agent.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run pack:check",
    "pack:check": "pnpm pack --pack-destination .pack-test && node scripts/verify-pack.mjs && node scripts/clean-pack.mjs",
    "prepare": "pnpm run build",
    "smoke:dsh": "node scripts/dsh-smoke.mjs",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "sidechat",
    "parallel-chat"
  ],
  "author": "Glaz-j",
  "license": "MIT",
  "homepage": "https://github.com/Glaz-j/dsh-parallel-chat#readme",
  "bugs": {
    "url": "https://github.com/Glaz-j/dsh-parallel-chat/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Glaz-j/dsh-parallel-chat.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session-persistence": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-subagent": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-workspace": "^0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    },
    "@deepseek-ai/dsh-workspace": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session-persistence": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subagent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-workspace": "0.1.0-rc.7",
    "@vitest/coverage-v8": "^3.2.4",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
